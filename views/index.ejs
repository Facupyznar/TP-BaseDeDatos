<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <title>MovieWeb</title>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

<%- include('components/NavBar.ejs', { user: (typeof user !== 'undefined' ? user : null), isAdmin: (typeof isAdmin !== 'undefined' ? isAdmin : false) }) %>

<!-- Hero centrado -->
<main class="home">
    <h1 class="home-title">MovieWeb</h1>
    <form class="searchbar home-search" action="/buscar" method="GET">
        <select name="type" aria-label="Tipo de búsqueda">
            <option value="todo" selected>Todo</option>
            <option value="movie">Película</option>
            <option value="actor">Actor</option>
            <option value="director">Director</option>
            <option value="keyword">Keyword</option>
        </select>
        <input class="input" type="text" name="q" placeholder="Buscar..." required />
        <button class="btn" type="submit">Buscar</button>
    </form>
</main>

<!-- Carouseles de películas por género -->
<div class="carousels-wrapper">
    <% if (typeof carousels !== 'undefined' && carousels.length > 0) { %>
        <% carousels.forEach(carousel => { %>
            <%- include('components/Carousel.ejs', {
                title: carousel.title,
                movies: carousel.movies,
                carouselId: carousel.carouselId
            }) %>
        <% }) %>
    <% } %>
</div>

<script>
    function toggleMenu() {
        const btn = document.getElementById("menuButton");
        const menu = document.getElementById("menuContent");
        btn.classList.toggle("open");
        menu.classList.toggle("open");
    }

    function scrollCarousel(carouselId, direction) {
        const container = document.getElementById(carouselId);
        const track = container.querySelector('.carousel-track');
        const scrollAmount = 400; // píxeles a desplazar

        if (track) {
            track.scrollBy({
                left: direction * scrollAmount,
                behavior: 'smooth'
            });
        }
    }
</script>

</body>
</html>
