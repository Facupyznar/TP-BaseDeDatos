<link rel="stylesheet" href="/styles/NavBarStyle.css">
<header class="main-nav">

    <div class="nav-left">
        <a href="/" class="logo">MovieWeb</a>
    </div>

    <div class="nav-right">
        <% if (!user) { %>
            <a href="/login" class="menu-link">Iniciar sesión</a>
            <a href="/register" class="menu-link">Registrarse</a>
        <% } else if (isAdmin) { %>
            <a href="/users" class="menu-link">Lista de usuarios</a>
            <form action="/logout" method="POST" class="logout-form">
                <button class="menu-link logout-btn" type="submit">Cerrar sesión</button>
            </form>
        <% } else { %>
            <a href="/profile/<%= user.id %>" class="menu-link">Mi perfil</a>
            <form action="/logout" method="POST" class="logout-form">
                <button class="menu-link logout-btn" type="submit">Cerrar sesión</button>
            </form>
        <% } %>
    </div>
</header>